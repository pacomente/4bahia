{
  "name": "voxelia",
  "productName": "Voxelia",
  "version": "0.10.0",
  "description": "Juego de mundo abierto de bloques con su launcher.",
  "author": "Voxelia",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "launcher/main.cjs",
  "scripts": {
    "dev": "vite --config game/vite.config.js",
    "build": "vite build --config game/vite.config.js",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "test": "node --test game/test/world.test.js game/test/survival.test.js game/test/v03.test.js game/test/v04.test.js game/test/v05.test.js game/test/v06.test.js game/test/v07.test.js game/test/v08.test.js game/test/v09.test.js game/test/v10.test.js game/test/v11.test.js game/test/v13.test.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "simplex-noise": "4.0.3",
    "three": "0.186.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.voxelia.game",
    "productName": "Voxelia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "launcher/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Voxelia-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Voxelia"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pacomente/4bahia.git",
    "directory": "voxelia"
  }
}
